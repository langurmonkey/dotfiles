#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# Dotfiles deployment
# ============================================================

DOTFILES_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DIR_PROJ="$HOME/Projects"
CONFIG="$HOME/.config"
LOCAL_BIN="$HOME/.local/bin"
LOCAL_FONTS="$HOME/.local/share/fonts"

# Colors
if [[ -t 1 ]]; then
    BLUE='\033[0;34m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    DIM='\033[38;5;240m'
    RESET='\033[0m'
else
    BLUE='' GREEN='' YELLOW='' RED='' DIM='' RESET=''
fi

# Deployment summary
declare -a INSTALLED=()
declare -a SKIPPED=()
declare -a FAILED=()

# ============================================================
# Logging
# ============================================================

info() { printf "${BLUE}[ .. ]${RESET} %s\n" "$*"; }
ok()   { printf "${GREEN}[ OK ]${RESET} %s\n" "$*"; }
skip() { printf "${DIM}[SKIP]${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}[WARN]${RESET} %s\n" "$*"; }
fail() { printf "${RED}[FAIL]${RESET} %s\n" "$*" >&2; }

section() {
    printf "\n${YELLOW}==== %s ====${RESET}\n\n" "$*"
}

on_error() {
    local rc=$?
    fail "Unexpected error (exit $rc, line ${BASH_LINENO[0]})"
    exit "$rc"
}
trap on_error ERR

# ============================================================
# Interactive prompts
# ============================================================

ask() {
    local prompt=$1 default=${2:-y} answer

    if (( YES )); then
        [[ $default == y ]]
        return
    fi

    while true; do
        if [[ $default == y ]]; then
            read -r -p "$prompt [Y/n] " answer || answer=''
            answer=${answer:-y}
        else
            read -r -p "$prompt [y/N] " answer || answer=''
            answer=${answer:-n}
        fi

        case "$answer" in
            y|Y|yes|YES) return 0 ;;
            n|N|no|NO)   return 1 ;;
            *) printf 'Please answer y or n.\n' ;;
        esac
    done
}


choose() {
    local prompt=$1
    shift

    local options=("$@")
    local answer
    local old_ps3=${PS3-}

    printf '\n%s\n' "$prompt" >&2
    PS3="Choice: "

    select answer in "${options[@]}"; do
        if [[ -n ${answer:-} ]]; then
            break
        fi
        printf 'Invalid choice. Try again.\n' >&2
    done

    PS3=$old_ps3
    printf '%s\n' "$answer"
}


usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Options:
  -y, --yes       Use defaults without prompting
  -h, --help      Show this help

Without --yes, deployment choices are interactive.
EOF
}

YES=0

while (($#)); do
    case "$1" in
        -y|--yes)  YES=1 ;;
        -h|--help) usage; exit 0 ;;
        *)         fail "Unknown option: $1"; usage; exit 2 ;;
    esac
    shift
done

# ============================================================
# Filesystem helpers
# ============================================================

# Safely back up an existing file, directory, or symlink.
backup() {
    local path=$1
    local destination="${path}.bak.$(date +%Y%m%d-%H%M%S)"

    mv -- "$path" "$destination"
    warn "Backed up $path to $destination"
}

# Create a symlink without silently destroying existing data.
link() {
    local source=$1 destination=$2
    local parent

    if [[ ! -e $source && ! -L $source ]]; then
        fail "Source does not exist: $source"
        FAILED+=("$destination")
        return 1
    fi

    parent=$(dirname -- "$destination")
    mkdir -p -- "$parent"

    # Already correctly linked.
    if [[ -L $destination ]] &&
       [[ $(readlink -- "$destination") == "$source" ]]; then
        skip "$destination"
        SKIPPED+=("$destination")
        return 0
    fi

    # Preserve conflicting files, directories, and broken symlinks.
    if [[ -e $destination || -L $destination ]]; then
        backup "$destination"
    fi

    ln -s -- "$source" "$destination"
    ok "$destination -> $source"
    INSTALLED+=("$destination")
}

# Clone a repository if absent; update it if already present.
clone_repo() {
    local destination=$1 url=$2 name=$3

    if [[ -d $destination/.git ]]; then
        info "Updating $name"
        if git -C "$destination" pull --ff-only; then
            ok "$name"
            SKIPPED+=("$name (already installed; updated)")
        else
            fail "Could not update $name"
            FAILED+=("$name")
        fi
    elif [[ -e $destination ]]; then
        warn "Skipping $name: destination exists and is not a Git repository"
        SKIPPED+=("$name")
    else
        mkdir -p -- "$(dirname -- "$destination")"
        info "Installing $name"
        if git clone "$url" "$destination"; then
            ok "$name"
            INSTALLED+=("$name")
        else
            fail "Could not clone $name"
            FAILED+=("$name")
        fi
    fi
}

# Add a source statement to Bash or Zsh rc files.
source_env() {
    local shell=$1 file=$2 rc marker

    case "$shell" in
        bash) rc="$HOME/.bashrc" ;;
        zsh)  rc="$HOME/.zshrc" ;;
        *)    return 2 ;;
    esac

    [[ -x $(command -v "$shell" 2>/dev/null) ]] || return 0
    [[ -f $file ]] || {
        warn "Missing environment file: $file"
        return 0
    }

    mkdir -p -- "$(dirname -- "$rc")"
    touch "$rc"

    marker="# dotfiles: $(basename "$file")"
    if grep -Fq -- "$marker" "$rc"; then
        skip "$rc already sources $(basename "$file")"
        return 0
    fi

    {
        printf '\n%s\n' "$marker"
        printf '[[ -f %q ]] && source %q\n' "$file" "$file"
    } >> "$rc"

    ok "Added $(basename "$file") to $rc"
    INSTALLED+=("$rc")
}

# Link a directory of configuration files.
link_config() {
    local name=$1 source=$2 destination=$3

    section "$name"
    link "$source" "$destination"
}

# ============================================================
# Choose what to deploy
# ============================================================

section "Deployment options"

if (( YES )); then
    WM=hyprland
    BAR=waybar
    TERMINAL=both
else
    WM=$(choose "Which window manager / compositor?" \
        hyprland i3 sway none)

    case "$WM" in
        hyprland|sway)
            BAR=$(choose "Which panel / bar?" \
                waybar noctalia none)
            ;;
        i3)
            BAR=$(choose "Which panel / bar?" \
                polybar i3blocks waybar none)
            ;;
        *)
            BAR=none
            ;;
    esac

    TERMINAL=$(choose "Which terminal configuration?" \
        both kitty alacritty none)
fi

# ============================================================
# Core configuration
# ============================================================

section "Core configuration"

link "$DOTFILES_PATH/mailcap/.mailcap" "$HOME/.mailcap"
link "$DOTFILES_PATH/nvim" "$CONFIG/nvim"
mkdir -p "$CONFIG/nvim/spell"
link "$DOTFILES_PATH/words/en.utf-8.dic" \
    "$CONFIG/nvim/spell/en.utf-8.add"

link "$DOTFILES_PATH/helix" "$CONFIG/helix"
link "$DOTFILES_PATH/mitos" "$CONFIG/mitos"

link "$DOTFILES_PATH/git/.gitconfig" "$HOME/.gitconfig"
link "$DOTFILES_PATH/jj" "$CONFIG/jj"
link "$DOTFILES_PATH/fish" "$CONFIG/fish"
link "$DOTFILES_PATH/starship/starship.toml" \
    "$CONFIG/starship.toml"

# Shell environment
for file in env_global.sh env_fun.sh; do
    source_env bash "$DOTFILES_PATH/env/$file"
    source_env zsh "$DOTFILES_PATH/env/$file"
done

if [[ -f /etc/arch-release ]]; then
    source_env bash "$DOTFILES_PATH/env/env_arch.sh"
    source_env zsh "$DOTFILES_PATH/env/env_arch.sh"
fi

# Shell plugins
if [[ -d ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom} ]]; then
    ZSH_PLUGINS="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"

    clone_repo "$ZSH_PLUGINS/zsh-autosuggestions" \
        https://github.com/zsh-users/zsh-autosuggestions \
        zsh-autosuggestions

    clone_repo "$ZSH_PLUGINS/zsh-syntax-highlighting" \
        https://github.com/zsh-users/zsh-syntax-highlighting \
        zsh-syntax-highlighting
else
    skip "Zsh plugins: Oh My Zsh custom directory not found"
    SKIPPED+=("Zsh plugins")
fi

# Tmux and GNU Screen
link "$DOTFILES_PATH/tmux/.tmux.conf" "$HOME/.tmux.conf"
link "$DOTFILES_PATH/screen/.screenrc" "$HOME/.screenrc"

if ask "Install/update tmux-resurrect?" n; then
    clone_repo "$DIR_PROJ/tmux-resurrect" \
        https://github.com/tmux-plugins/tmux-resurrect \
        tmux-resurrect
fi

# File managers
link "$DOTFILES_PATH/ranger/scope.sh" "$CONFIG/ranger/scope.sh"
link "$DOTFILES_PATH/ranger/rc.conf" "$CONFIG/ranger/rc.conf"
link "$DOTFILES_PATH/ranger/rifle.conf" "$CONFIG/ranger/rifle.conf"
link "$DOTFILES_PATH/nnn" "$CONFIG/nnn"
link "$DOTFILES_PATH/lf" "$CONFIG/lf"
link "$DOTFILES_PATH/yazi" "$CONFIG/yazi"

# Media and applications
link "$DOTFILES_PATH/ncmpcpp" "$CONFIG/ncmpcpp"
link "$DOTFILES_PATH/mpd/config" "$CONFIG/mpd"
link "$DOTFILES_PATH/mpd/playlists" "$HOME/.local/share/mpd/playlists"
link "$DOTFILES_PATH/cava" "$CONFIG/cava"
link "$DOTFILES_PATH/newsboat" "$CONFIG/newsboat"
link "$DOTFILES_PATH/mutt" "$CONFIG/mutt"
link "$DOTFILES_PATH/mpv" "$CONFIG/mpv"
link "$DOTFILES_PATH/qutebrowser/config" "$CONFIG/qutebrowser"
link "$DOTFILES_PATH/qutebrowser/data/userscripts" \
    "$HOME/.local/share/qutebrowser/userscripts"
link "$DOTFILES_PATH/qutebrowser/data/greasemonkey" \
    "$HOME/.local/share/qutebrowser/greasemonkey"
link "$DOTFILES_PATH/fnott" "$CONFIG/fnott"
link "$DOTFILES_PATH/xob" "$CONFIG/xob"

# Mutt cache directories are runtime data, not configuration.
mkdir -p "$HOME/.cache/mutt/ari.uni-heidelberg.de" \
    "$HOME/.cache/mutt/tonisagrista.com"

# ============================================================
# Window manager / compositor
# ============================================================

case "$WM" in
    hyprland)
        link_config "Hyprland" "$DOTFILES_PATH/hyprland" "$CONFIG/hypr"
        ;;
    i3)
        link_config "i3" "$DOTFILES_PATH/i3" "$CONFIG/i3"
        ;;
    sway)
        link_config "Sway" "$DOTFILES_PATH/sway" "$CONFIG/sway"
        ;;
    none)
        skip "Window manager / compositor"
        ;;
esac

# ============================================================
# Panel / bar
# ============================================================

case "$BAR" in
    waybar)
        link_config "Waybar" "$DOTFILES_PATH/waybar" "$CONFIG/waybar"
        ;;
    polybar)
        link_config "Polybar" "$DOTFILES_PATH/polybar" "$CONFIG/polybar"
        clone_repo "$DIR_PROJ/polybar-scripts" \
            https://github.com/x70b1/polybar-scripts.git \
            polybar-scripts
        ;;
    i3blocks)
        link_config "i3blocks" "$DOTFILES_PATH/i3blocks" "$CONFIG/i3blocks"
        ;;
    noctalia)
        link_config "Noctalia" "$DOTFILES_PATH/noctalia" "$CONFIG/noctalia"
        ;;
    none)
        skip "Panel / bar"
        ;;
esac

# ============================================================
# Terminal configuration
# ============================================================

case "$TERMINAL" in
    both|kitty)
        link_config "Kitty" "$DOTFILES_PATH/kitty" "$CONFIG/kitty"
        ;;&
    both|alacritty)
        link_config "Alacritty" "$DOTFILES_PATH/alacritty" "$CONFIG/alacritty"
        ;;
esac

if [[ $TERMINAL == none ]]; then
    skip "Terminal configuration"
fi

# ============================================================
# X11 / X resources
# ============================================================

if ask "Deploy X11 resources and URxvt configuration?" n; then
    mkdir -p "$HOME/.urxvt/ext"

    # Use the normal DPI configuration as a safe fallback.
    if command -v xwininfo >/dev/null 2>&1; then
        XRES_H=$(xwininfo -root | sed -n 's/.*Height: *//p')
        XRES_W=$(xwininfo -root | sed -n 's/.*Width: *//p')
    else
        XRES_H=0
        XRES_W=0
    fi

    MYHOSTNAME=$(hostname)

    if { [[ $XRES_H =~ ^[0-9]+$ ]] &&
         [[ $XRES_W =~ ^[0-9]+$ ]] &&
         (( XRES_H > 1400 && XRES_W > 2000 )); } ||
       [[ $MYHOSTNAME == hidalgo ]]; then
        link "$DOTFILES_PATH/X/.Xresources-hidpi" "$HOME/.Xresources"
        link "$DOTFILES_PATH/X/.Xdefaults-hidpi" "$HOME/.Xdefaults"
    else
        link "$DOTFILES_PATH/X/.Xdefaults" "$HOME/.Xdefaults"
    fi

    link "$DOTFILES_PATH/X/.xinitrc" "$HOME/.xinitrc"
    link "$DOTFILES_PATH/urxvt/font-size" "$HOME/.urxvt/ext/font-size"
fi

# ============================================================
# Fonts and utilities
# ============================================================

if ask "Deploy fonts and refresh font cache?" y; then
    if [[ -d "$DOTFILES_PATH/fonts/ttf" ]]; then
        link "$DOTFILES_PATH/fonts/ttf" "$LOCAL_FONTS/ttf"
    else
        warn "TTF font directory not found; skipping"
        SKIPPED+=("TTF fonts")
    fi

    if command -v fc-cache >/dev/null 2>&1; then
        if fc-cache -f; then
            ok "Font cache refreshed"
        else
            fail "Could not refresh font cache"
            FAILED+=("font cache")
        fi
    else
        warn "fc-cache is not installed"
    fi
fi

# ============================================================
# Summary
# ============================================================

section "Deployment summary"

printf "${GREEN}Installed / changed:${RESET} %d\n" "${#INSTALLED[@]}"
printf "${DIM}Skipped:${RESET} %d\n" "${#SKIPPED[@]}"
printf "${RED}Failed:${RESET} %d\n" "${#FAILED[@]}"

if ((${#FAILED[@]})); then
    printf '\nFailed items:\n'
    printf '  - %s\n' "${FAILED[@]}"
    exit 1
fi

printf '\n'
ok "Deployment finished"
